# Vector search index (regenerable from source files)
index/

# Python
__pycache__/
*.pyc

# Virtual environment (no trailing slash — .venv is a symlink on server)
.venv

# Environment
.env

# Manager local config (only the runtime copy at the repo root; the
# install/ template is checked in).
/.manager.json
/assistant_config.json

# Web app build output (apps/web/ has its own .gitignore too)
apps/web/dist/
apps/web/node_modules/

# Local logs
logs/

# Machine-local backend state (backend/api/open_sessions.py)
state/
remote_console.log

# Context is an independent repo, ignored here
context/

# Claude Code SDK config (symlink to context/)
.claude_config/

# Per-user CLI runtime dirs — auto-generated by each agent on first run.
# Contents are machine-local (settings.local.json, lock files, symlinks).
# Cross-machine sync of these is handled separately via context/.
.claude/
.qwen/
.gemini/

# Claude Code runtime artifacts (created if CLAUDE_CONFIG_DIR is not set)
.claude.json
.claude.json.backup.*
debug/
!apps/android/**/src/debug/
# Repo-root runtime/media dir only (anchored: docs/projects/ and fixture folders named projects/ are tracked)
/projects/
todos/
plugins/

# Secrets, credentials, and certificates
secrets/
certs/

# Temporary files
.index-temp/
*.egg-info/
.ruff_cache/
.mypy_cache/

# Old Android app, kept under legacy/ since the 2026-10 cutover
legacy/android/.gradle/
legacy/android/app/build/
legacy/android/app/.cxx/
legacy/android/build/
legacy/android/local.properties
legacy/android/**/*.apk
legacy/android/**/*.aab

# Android Device companion app
apps/android-device/.gradle/
apps/android-device/app/build/
apps/android-device/build/
apps/android-device/local.properties
apps/android-device/**/*.apk
apps/android-device/**/*.aab
infra/sync/config.env
docs/projects/frontend-refactor/audit/screenshots/

# Android apps (apps/android/, own .gitignore): signing paths/passwords, never committed (spec 14 §1.8)
apps/android/keystore.properties

# Backups Settings → Accounts keeps of context/.env (secrets; never synced or committed)
.backups/
